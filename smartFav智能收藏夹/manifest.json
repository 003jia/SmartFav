{
  "manifest_version": 3,
  "name": "SmartFav - 智能收藏夹",
  "version": "1.1.2",
  "description": "本地关键词优先、AI 可选增强的智能网页收藏夹",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
